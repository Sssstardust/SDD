{
  "name": "SDD Doctor Diagnostics",
  "categories": [
    {
      "id": "toolchain",
      "name": "Toolchain",
      "rules": [
        {
          "type": "command_version",
          "id": "python",
          "command": [
            "python",
            "--version"
          ],
          "required_major": 3,
          "required_minor": 13,
          "description": "Python"
        },
        {
          "type": "command_version",
          "id": "node",
          "command": [
            "node",
            "--version"
          ],
          "required_major": 18,
          "required_minor": 0,
          "description": "Node.js"
        },
        {
          "type": "command_version",
          "id": "javac",
          "command": [
            "javac",
            "--version"
          ],
          "required_major": 0,
          "required_minor": 0,
          "condition": "needs_java",
          "severity": "WARN",
          "description": "javac"
        }
      ]
    },
    {
      "id": "workspace",
      "name": "Workspace",
      "rules": [
        {
          "type": "path_exists",
          "path": "README.md",
          "description": "README"
        },
        {
          "type": "path_exists",
          "path": "skills/sdd-assistant/SKILL.md",
          "description": "sdd-assistant Skill"
        }
      ]
    },
    {
      "id": "mcp",
      "name": "MCP",
      "rules": [
        {
          "type": "path_exists",
          "path": "mcp-servers/sdd-pipeline/server.py",
          "description": "sdd-pipeline MCP server"
        }
      ]
    },
    {
      "id": "custom_checks",
      "name": "Custom Checks",
      "rules": [
        {
          "type": "custom_pytest_baseline",
          "description": "Test Baseline"
        },
        {
          "type": "custom_polyquery",
          "description": "PolyQuery"
        },
        {
          "type": "custom_attached_project",
          "description": "Attached Project"
        },
        {
          "type": "custom_baseline_governance",
          "description": "Baseline Governance"
        },
        {
          "type": "custom_security",
          "description": "Security Secrets Scan"
        }
      ]
    }
  ]
}
