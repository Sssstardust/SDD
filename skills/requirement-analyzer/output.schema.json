{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/skills/requirement-analyzer/output.schema.json",
  "title": "Requirement Analyzer Output",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "source", "output", "ai_used"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["ready", "clarify"],
      "description": "解析状态"
    },
    "source": {
      "type": "string",
      "description": "源文件路径"
    },
    "output": {
      "type": "string",
      "description": "生成的 structured-prd.json 路径"
    },
    "feature_brief": {
      "type": ["string", "null"],
      "description": "生成的 需求规格.md 路径"
    },
    "capability_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "提取的能力标签"
    },
    "risk_tier": {
      "type": "string",
      "enum": ["low", "high"],
      "description": "风险等级"
    },
    "ai_used": {
      "type": "boolean",
      "description": "是否使用了 AI"
    }
  }
}
