{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/skills/sdd-validate/output.schema.json",
  "title": "SDD Validate Output",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "results"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["ok", "fail", "error"],
      "description": "校验总体状态"
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["gate", "success"],
        "properties": {
          "gate": { "type": "string" },
          "success": { "type": "boolean" },
          "exit_code": { "type": "integer" },
          "message": { "type": "string" }
        }
      },
      "description": "各 Gate 的详细结果"
    },
    "summary": {
      "type": "string",
      "description": "校验结论摘要"
    }
  }
}
