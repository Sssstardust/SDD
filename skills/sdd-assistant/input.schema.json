{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/skills/sdd-assistant/input.schema.json",
  "title": "SDD Assistant Input",
  "type": "object",
  "additionalProperties": false,
  "required": ["source_file", "workspace", "feature_name"],
  "properties": {
    "source_file": {
      "type": "string",
      "description": "原始 PRD/需求文本路径"
    },
    "workspace": {
      "type": "string",
      "description": "feature 工作目录"
    },
    "feature_name": {
      "type": "string",
      "description": "feature 名称"
    },
    "force": {
      "type": "boolean",
      "default": false,
      "description": "是否强制覆盖已有产物"
    },
    "strict": {
      "type": "boolean",
      "default": false,
      "description": "是否启用架构红线严格校验"
    },
    "no_ai": {
      "type": "boolean",
      "default": false,
      "description": "禁用 AI，仅走确定性流程"
    }
  }
}
